direction: right

extension: "pi-bash-cap extension (index.ts)" {
  handler: "tool_result handler" {
    label: "pi.on(\"tool_result\", handler)"
  }
}

env: "Environment Variables" {
  PI_BASH_CAP_LINES
  PI_BASH_CAP_BYTES
  PI_BASH_CAP_HEAD
  PI_BASH_CAP_TAIL
  PI_BASH_CAP_OFF
}

spill: "Spill Dir\n~/.pi/bash-cap-spill/<session-id>/" {
  shape: cylinder
}

model: "Model Context" {
  shape: page
}

env -> handler: configure thresholds
handler -> handler: inspect event.input.command
handler -> handler: measure content[].text

handler -> spill: "write full output\n(when over threshold)"
handler -> model: "replace content[].text\n(head + cap notice + tail)"
handler -> handler: "pass-through\n(when under threshold,\nerror, nocap, or OFF)"

handler.exit: "Error path" {
  shape: diamond
}
handler -> handler.exit: "on any failure:\nreturn undefined\n(original result preserved)"
handler.exit -> model: "original content\npasses through untouched"