direction: right

extension: "pi-bash-cap extension" {
  handler: "tool_result handler" {
    label: "pi.on(\"tool_result\", ...)"
  }
}

env: "Environment Variables" {
  vars: "PI_BASH_CAP_LINES\nPI_BASH_CAP_BYTES\nPI_BASH_CAP_HEAD\nPI_BASH_CAP_TAIL\nPI_BASH_CAP_OFF"
}

spill: "Spill Dir" {
  shape: cylinder
  label: "~/.pi/bash-cap-spill/<sid>/"
}

model: "Model Context" {
  shape: page
}

env -> handler: "configure thresholds"
handler -> handler: "inspect event.input.command"
handler -> handler: "measure content text"

handler -> spill: "write full output\n(over threshold)"
handler -> model: "replace content text\n(head + notice + tail)"
handler -> model: "pass-through\n(under threshold)"

handler.exit: "Error path" {
  shape: diamond
}
handler -> handler.exit: "on any failure"
handler.exit -> model: "original content\nuntouched"